[Unit]
Description=LabsOS API
After=network.target

[Service]
Type=simple
User=agent
Group=agent
Environment=LABSOS_MODE=linux
Environment=LABSOS_ADDR=127.0.0.1:8080
ExecStart=/usr/local/bin/labs-api
Restart=on-failure
RestartSec=2
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadWritePaths=/run/labsos
ReadWritePaths=/var/lib/labsos/catalog
ReadWritePaths=/var/lib/labsos/update
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
