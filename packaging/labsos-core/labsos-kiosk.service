[Unit]
Description=LabsOS browser kiosk
After=graphical-session.target labs-api.service labs-dashboard.service
Wants=labs-api.service labs-dashboard.service
PartOf=graphical-session.target

[Service]
Type=simple
User=labs
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/lib/labsos/labsos-kiosk
Restart=always
RestartSec=2
RestartPreventExitStatus=0

[Install]
WantedBy=graphical.target
