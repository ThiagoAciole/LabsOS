#!/bin/sh
set -eu

# This is the only component allowed to touch the selected installation disk.
# It is deliberately double-gated: the public wrapper validates the target and
# this backend validates the same policy again before invoking destructive tools.
[ "${LABSOS_ENABLE_REAL_OPERATIONS:-}" = "true" ] || exit 64
[ -n "${LABSOS_CONFIRM_REAL_OPERATIONS:-}" ] || exit 64
[ "${LABSOS_INSTALLER_ALLOW_DESTRUCTIVE:-}" = "true" ] || exit 64

job= operation= disk= preserve=false server_name= password_file=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --job) job=${2:?missing job}; shift 2 ;;
    --operation) operation=${2:?missing operation}; shift 2 ;;
    --disk) disk=${2:?missing disk}; shift 2 ;;
    --preserve) preserve=${2:?missing preserve}; shift 2 ;;
    --server-name) server_name=${2:?missing server name}; shift 2 ;;
    --password-file) password_file=${2:?missing password file}; shift 2 ;;
    *) echo "unknown installer backend argument" >&2; exit 64 ;;
  esac
done

case "$operation" in fresh|restore|transfer) ;; *) exit 64 ;; esac
[ -n "$job" ] && [ -n "$server_name" ] && [ -r "$password_file" ] || exit 64
case "$disk" in /dev/*) ;; *) exit 64 ;; esac
[ "$(lsblk -dn -o TYPE "$disk" 2>/dev/null)" = disk ] || exit 65
[ "$(lsblk -dn -o RO "$disk" 2>/dev/null)" = 0 ] || exit 65

# A plan can be exercised in CI without opening a block device. No partition
# or filesystem command is reached in this mode.
if [ "${LABSOS_INSTALLER_DRY_RUN:-}" = true ]; then
  printf '%s\n' "job=$job operation=$operation disk=$disk preserve=$preserve server=$server_name"
  exit 0
fi

source_dir=${LABSOS_INSTALLER_SOURCE:-/}
[ -d "$source_dir" ] || { echo "installer source is unavailable" >&2; exit 66; }
command -v sfdisk >/dev/null || { echo "sfdisk is unavailable" >&2; exit 69; }
command -v mkfs.ext4 >/dev/null || { echo "mkfs.ext4 is unavailable" >&2; exit 69; }
command -v mkfs.fat >/dev/null || { echo "mkfs.fat is unavailable" >&2; exit 69; }
command -v mount >/dev/null || exit 69
command -v umount >/dev/null || exit 69

case "$disk" in
  /dev/nvme*|/dev/mmcblk*|/dev/loop*) part_suffix=p ;;
  *) part_suffix= ;;
esac
efi=${disk}${part_suffix}1
root=${disk}${part_suffix}2
target=$(mktemp -d /tmp/labsos-install.XXXXXX)
cleanup() {
  umount "$target/dev" 2>/dev/null || true
  umount "$target/proc" 2>/dev/null || true
  umount "$target/sys" 2>/dev/null || true
  umount "$target/boot/efi" 2>/dev/null || true
  umount "$target" 2>/dev/null || true
  rmdir "$target" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [ "$operation" = fresh ] || [ "$preserve" != true ]; then
  printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk --wipe always "$disk"
  partprobe "$disk" 2>/dev/null || true
  mkfs.fat -F32 -n LABSOS_EFI "$efi"
  mkfs.ext4 -F -L LABSOS "$root"
else
  [ -b "$root" ] || { echo "preserve requested but existing root partition is unavailable" >&2; exit 65; }
fi

mount "$root" "$target"
mkdir -p "$target/boot/efi"
mount "$efi" "$target/boot/efi"

# Copy only the live system tree. Explicit exclusions prevent crossing into
# host runtime mounts or copying the target back into itself.
if command -v rsync >/dev/null; then
  rsync -aHAX --numeric-ids --delete \
    --exclude=/dev/* --exclude=/proc/* --exclude=/sys/* --exclude=/run/* \
    --exclude=/etc/systemd/system/labs-api.service.d/* \
    --exclude=/tmp/* --exclude=/mnt/* --exclude=/media/* --exclude=/lost+found \
    "$source_dir/" "$target/"
else
  (cd "$source_dir" && tar --one-file-system --exclude=./dev --exclude=./proc --exclude=./sys --exclude=./run --exclude=./tmp --exclude=./mnt --exclude=./media -cpf - .) | (cd "$target" && tar -xpf -)
fi

mkdir -p "$target/etc"
printf '%s\n' "$server_name" > "$target/etc/hostname"
printf 'LABEL=LABSOS / ext4 defaults 0 1\n' > "$target/etc/fstab"
printf 'LABEL=LABSOS_EFI /boot/efi vfat defaults 0 2\n' >> "$target/etc/fstab"
if [ -s "$password_file" ] && [ -x "$target/usr/sbin/chpasswd" ]; then
  password=$(head -n 1 "$password_file")
  printf 'labs:%s\n' "$password" | chroot "$target" chpasswd
fi
if command -v grub-install >/dev/null && [ -x "$target/usr/sbin/update-initramfs" ]; then
  mount --bind /dev "$target/dev"
  mount -t proc proc "$target/proc"
  mount -t sysfs sys "$target/sys"
  grub-install --target=x86_64-efi --efi-directory="$target/boot/efi" --bootloader-id=LabsOS --removable --root-directory="$target" "$disk"
  chroot "$target" update-initramfs -c -k all
fi
printf '%s\n' "LabsOS installation completed: $job"
