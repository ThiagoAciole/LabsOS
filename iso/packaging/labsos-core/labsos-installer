#!/bin/sh
set -eu

# The API has a safety gate; this executable adds an independent fail-closed
# boundary for direct invocation from a shell or another service.
[ "${LABSOS_ENABLE_REAL_OPERATIONS:-}" = "true" ] || { echo "real operations are disabled" >&2; exit 64; }
[ -n "${LABSOS_CONFIRM_REAL_OPERATIONS:-}" ] || { echo "explicit confirmation is required" >&2; exit 64; }
[ "${LABSOS_INSTALLER_ALLOW_DESTRUCTIVE:-}" = "true" ] || { echo "destructive installer gate is disabled" >&2; exit 64; }

job= operation= disk= preserve=false server_name= password_file=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --job) job=${2:?missing job}; shift 2 ;;
    --operation) operation=${2:?missing operation}; shift 2 ;;
    --disk) disk=${2:?missing disk}; shift 2 ;;
    --preserve) preserve=${2:?missing preserve}; shift 2 ;;
    --server-name) server_name=${2:?missing server name}; shift 2 ;;
    --password-file) password_file=${2:?missing password file}; shift 2 ;;
    *) echo "unknown installer argument" >&2; exit 64 ;;
  esac
done

case "$operation" in fresh|restore|transfer) ;; *) echo "invalid operation" >&2; exit 64 ;; esac
[ -n "$job" ] && [ -n "$server_name" ] && [ -r "$password_file" ] || { echo "incomplete installer request" >&2; exit 64; }
case "$disk" in /dev/*) ;; *) echo "disk must be an absolute device path" >&2; exit 64 ;; esac
[ "$(lsblk -dn -o TYPE "$disk" 2>/dev/null)" = "disk" ] || { echo "target is not a whole disk" >&2; exit 65; }
[ "$(lsblk -dn -o RO "$disk" 2>/dev/null)" = "0" ] || { echo "target disk is read-only" >&2; exit 65; }

backend=${LABSOS_INSTALLER_BACKEND:-/usr/lib/labsos/labsos-installer-backend}
[ -x "$backend" ] || { echo "installer backend is not installed" >&2; exit 69; }
exec "$backend" --job "$job" --operation "$operation" --disk "$disk" --preserve "$preserve" --server-name "$server_name" --password-file "$password_file"
